PORT=
JWT_ISSUER=
JWT_AUDIENCE=
JWT_TIMEEXP=
JWT_SECRET=
DB_FILE=
# Allowed CORS origins, comma-separated: dashboard + customer portal.
# Local default: http://localhost:5173,http://localhost:3100. Render: https://agricultureops.netlify.app,<portal URL>
FRONTEND_URL=
# Requests per client IP per 15 minutes on /auth/login and /auth/register (defaults 20 and 10).
LOGIN_RATE_LIMIT=
REGISTER_RATE_LIMIT=
# First admin, created on startup only if no user has this email yet (never modifies an existing account).
# Min 8 characters. Leave blank once an admin exists; if both are blank and there's no active admin, a warning is logged.
ADMIN_EMAIL=
ADMIN_PASSWORD=
